<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base dark surface -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#131F30"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>

    <!-- Top-right emerald glow -->
    <item android:top="-80dp" android:right="-80dp" android:bottom="40dp" android:left="140dp">
        <shape android:shape="oval">
            <solid android:color="#1200FF87"/>
        </shape>
    </item>

    <!-- Stroke -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <stroke android:width="1dp" android:color="#2200FF87"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>

</layer-list>
