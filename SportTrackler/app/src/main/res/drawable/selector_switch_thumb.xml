<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Checked = light mode = sun (full yellow circle) -->
    <item android:state_checked="true" android:drawable="@drawable/thumb_sun"/>
    <!-- Unchecked = dark mode = moon (crescent) -->
    <item android:drawable="@drawable/thumb_moon"/>
</selector>
