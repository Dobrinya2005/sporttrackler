<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base: deep ocean teal-blue -->
    <item>
        <shape>
            <gradient android:type="linear" android:angle="150"
                android:startColor="#071E30"
                android:centerColor="#051520"
                android:endColor="#030D16"/>
        </shape>
    </item>

    <!-- Top-left cyan glow blob -->
    <item android:top="-190dp" android:right="180dp" android:bottom="530dp" android:left="-190dp">
        <shape android:shape="oval">
            <solid android:color="#083A50"/>
            <size android:width="370dp" android:height="370dp"/>
        </shape>
    </item>

    <!-- Bottom-right deep blue blob -->
    <item android:top="490dp" android:right="-170dp" android:bottom="-170dp" android:left="160dp">
        <shape android:shape="oval">
            <solid android:color="#052A40"/>
            <size android:width="340dp" android:height="340dp"/>
        </shape>
    </item>

    <!-- Mid teal accent -->
    <item android:top="260dp" android:right="230dp" android:bottom="330dp" android:left="-70dp">
        <shape android:shape="oval">
            <solid android:color="#0A4560"/>
            <size android:width="200dp" android:height="200dp"/>
        </shape>
    </item>

    <!-- Top-right small sparkle -->
    <item android:top="-50dp" android:right="-50dp" android:bottom="660dp" android:left="280dp">
        <shape android:shape="oval">
            <solid android:color="#0E5A78"/>
            <size android:width="120dp" android:height="120dp"/>
        </shape>
    </item>

</layer-list>
