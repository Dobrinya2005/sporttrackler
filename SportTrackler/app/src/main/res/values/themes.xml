<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== MAIN DARK THEME (2026) ===== -->
    <style name="Theme.FitnessTrainer" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent_indigo</item>
        <item name="colorPrimaryDark">@color/bg_surface</item>
        <item name="colorAccent">@color/accent_cyan</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:navigationBarColor">@color/bg_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="rippleColor">#335B6AF0</item>
        <!-- Theme attrs -->
        <item name="bgPrimary">@color/bg_primary</item>
        <item name="bgSurface">@color/bg_surface</item>
        <item name="bgElevated">@color/bg_elevated</item>
        <item name="textPrimary">@color/text_primary</item>
        <item name="textSecondary">@color/text_secondary</item>
        <item name="textHint">@color/text_hint</item>
        <item name="borderDefault">@color/border_default</item>
        <item name="accentMain">@color/accent_indigo</item>
    </style>

    <!-- ===== LIGHT THEME ===== -->
    <style name="Theme.FitnessTrainer.Light" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">#5B6AF0</item>
        <item name="colorPrimaryDark">@color/light_bg_primary</item>
        <item name="colorAccent">#0093E9</item>
        <item name="colorSurface">@color/light_bg_surface</item>
        <item name="colorOnSurface">@color/light_text_primary</item>
        <item name="android:windowBackground">@color/light_bg_primary</item>
        <item name="android:statusBarColor">@color/light_bg_primary</item>
        <item name="android:navigationBarColor">@color/light_bg_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:textColorPrimary">@color/light_text_primary</item>
        <item name="android:textColorSecondary">@color/light_text_secondary</item>
        <item name="android:textColorHint">@color/light_text_hint</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="rippleColor">#335B6AF0</item>
        <!-- Theme attrs -->
        <item name="bgPrimary">@color/light_bg_primary</item>
        <item name="bgSurface">@color/light_bg_surface</item>
        <item name="bgElevated">@color/light_bg_elevated</item>
        <item name="textPrimary">@color/light_text_primary</item>
        <item name="textSecondary">@color/light_text_secondary</item>
        <item name="textHint">@color/light_text_hint</item>
        <item name="borderDefault">@color/light_border_default</item>
        <item name="accentMain">@color/accent_indigo</item>
    </style>

    <!-- ===== SPLASH ===== -->
    <style name="Theme.FitnessTrainer.Splash" parent="Theme.FitnessTrainer">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:navigationBarColor">@color/bg_primary</item>
    </style>

    <!-- ===== COMPONENT STYLES ===== -->

    <!-- Card — glass morphism feel -->
    <style name="CardStyle" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/border_default</item>
        <item name="cardBackgroundColor">@color/bg_surface</item>
    </style>

    <!-- Outlined input field -->
    <style name="InputField" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/border_active</item>
        <item name="hintTextColor">@color/accent_indigo</item>
        <item name="boxBackgroundColor">@color/bg_surface</item>
        <item name="android:textColorHint">@color/text_secondary</item>
    </style>

    <!-- Primary gradient button -->
    <style name="PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="backgroundTint">@color/accent_indigo</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Chip / tag style -->
    <style name="MacroChip" parent="Widget.MaterialComponents.Chip.Action">
        <item name="chipCornerRadius">8dp</item>
        <item name="chipMinHeight">28dp</item>
        <item name="android:textSize">11sp</item>
        <item name="chipBackgroundColor">@color/bg_elevated</item>
    </style>

    <!-- Section header text -->
    <style name="SectionHeader">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_hint</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Circle image shape -->
    <style name="CircleImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- PIN numpad key -->
    <style name="PinKey" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:background">@drawable/bg_pin_key</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="rippleColor">#335B6AF0</item>
    </style>

    <!-- NavCard — coloured gradient card -->
    <style name="NavCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

</resources>
