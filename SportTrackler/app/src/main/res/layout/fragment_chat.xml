<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chat_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/chat_bg_default">

    <!-- Toolbar -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingTop="48dp"
        android:paddingBottom="10dp"
        android:background="@color/bg_elevated"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Back -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="←"
            android:textColor="@color/accent_cyan"
            android:textSize="20sp"
            android:padding="0dp"
            android:minWidth="0dp"/>

        <!-- Avatar + name row (clickable — opens info card) -->
        <LinearLayout
            android:id="@+id/btn_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp"
            android:paddingVertical="4dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">


            <!-- Contact avatar -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_toolbar_avatar"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_person"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_avatar_circle"
                android:clipToOutline="true"
                app:shapeAppearanceOverlay="@style/CircleImageView"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_contact_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"/>

                <TextView
                    android:id="@+id/tv_connection_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="● подключено"
                    android:textColor="@color/accent_emerald"
                    android:textSize="11sp"
                    android:visibility="gone"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Search button -->
        <ImageButton
            android:id="@+id/btn_search"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_search"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/text_hint"
            android:padding="8dp"
            android:contentDescription="Поиск"/>

    </LinearLayout>

    <!-- Search bar (replaces toolbar row when active) -->
    <LinearLayout
        android:id="@+id/layout_search_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp"
        android:background="@color/bg_elevated"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btn_search_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/text_hint"
            android:padding="8dp"
            android:contentDescription="Закрыть поиск"/>

        <EditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:hint="Поиск в сообщениях…"
            android:textColor="@color/text_primary"
            android:textColorHint="#8A8A8A"
            android:textSize="15sp"
            android:background="@null"
            android:inputType="text"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:paddingVertical="8dp"/>

        <TextView
            android:id="@+id/tv_search_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0/0"
            android:textColor="@color/text_hint"
            android:textSize="12sp"
            android:layout_marginEnd="4dp"/>

        <ImageButton
            android:id="@+id/btn_search_prev"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_arrow_up"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/accent_cyan"
            android:padding="8dp"
            android:contentDescription="Предыдущий результат"/>

        <ImageButton
            android:id="@+id/btn_search_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_arrow_down"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/accent_cyan"
            android:padding="8dp"
            android:contentDescription="Следующий результат"/>

    </LinearLayout>

    <!-- Client info card (collapsible) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_contact_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/bg_surface"
        app:layout_constraintTop_toBottomOf="@id/layout_search_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingBottom="16dp"
            android:paddingHorizontal="20dp"
            android:gravity="center_horizontal">

            <!-- Avatar centered -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_contact_avatar"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_person"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/CircleImageView"
                app:strokeWidth="2dp"
                app:strokeColor="@color/accent_indigo"/>

            <!-- Name -->
            <TextView
                android:id="@+id/tv_info_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"/>

            <!-- Email under name -->
            <TextView
                android:id="@+id/tv_info_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/text_hint"
                android:textSize="13sp"
                android:gravity="center"/>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                android:background="@color/border_default"/>

            <!-- Stats row: phone | email -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Phone -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📞  ТЕЛЕФОН"
                        android:textColor="@color/text_hint"
                        android:textSize="10sp"
                        android:letterSpacing="0.10"
                        android:fontFamily="sans-serif-medium"/>

                    <TextView
                        android:id="@+id/tv_info_phone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="—"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"/>

                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="40dp"
                    android:background="@color/border_default"/>

                <!-- Email short -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✉️  EMAIL"
                        android:textColor="@color/text_hint"
                        android:textSize="10sp"
                        android:letterSpacing="0.10"
                        android:fontFamily="sans-serif-medium"/>

                    <TextView
                        android:id="@+id/tv_info_email_short"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="—"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:ellipsize="end"
                        android:maxLines="1"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Messages list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_messages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingHorizontal="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/card_contact_info"
        app:layout_constraintBottom_toTopOf="@id/reply_preview"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Reply preview bar (shown above input when replying) -->
    <LinearLayout
        android:id="@+id/reply_preview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:background="@color/bg_elevated"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/input_panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="3dp"
            android:layout_height="36dp"
            android:background="@color/accent_cyan"
            android:layout_marginEnd="10dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_reply_to_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:id="@+id/tv_reply_to_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_hint"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"/>

        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_cancel_reply"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/text_hint"
            android:padding="6dp"
            android:contentDescription="Отменить ответ"/>

    </LinearLayout>

    <!-- Input panel -->
    <LinearLayout
        android:id="@+id/input_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="10dp"
        android:background="@color/bg_elevated"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Pill-shaped input container -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_chat_input_selector"
            android:paddingStart="12dp"
            android:paddingEnd="6dp"
            android:paddingVertical="4dp">

            <!-- Attachment button (paperclip) -->
            <ImageButton
                android:id="@+id/btn_attach"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_attach"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="@color/text_hint"
                android:scaleType="center"
                android:padding="6dp"
                android:contentDescription="Вложение"/>

            <!-- Text input (no outline box, raw EditText) -->
            <EditText
                android:id="@+id/et_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:hint="Сообщение…"
                android:textColor="@color/text_primary"
                android:textColorHint="#8A8A8A"
                android:textSize="15sp"
                android:background="@null"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:paddingVertical="8dp"/>

            <!-- Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:background="#3A3B43"
                android:layout_marginHorizontal="4dp"/>

            <!-- Mic button (shown when text is empty, hold to record) -->
            <ImageButton
                android:id="@+id/btn_mic"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_mic"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="@color/text_hint"
                android:scaleType="center"
                android:padding="6dp"
                android:contentDescription="Голосовое сообщение"/>

            <!-- Video note button (shown when text is empty, right of mic) -->
            <ImageButton
                android:id="@+id/btn_video_note"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_video_note"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="@color/text_hint"
                android:scaleType="center"
                android:padding="6dp"
                android:contentDescription="Видеосообщение"/>

            <!-- Send button (shown when text is not empty) -->
            <ImageButton
                android:id="@+id/btn_send"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_send"
                android:background="@drawable/bg_send_button"
                android:tint="@android:color/white"
                android:scaleType="center"
                android:padding="7dp"
                android:visibility="gone"
                android:contentDescription="Отправить"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Recording panel (replaces input while recording) -->
    <LinearLayout
        android:id="@+id/recording_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bg_elevated"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- HOLD MODE: swipe hints -->
        <LinearLayout
            android:id="@+id/layout_hold_hints"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="2dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔴"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/tv_recording_time"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="0:00"
                android:textColor="@color/accent_rose"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"/>

            <com.fitnesstrainer.app.ui.chat.WaveformView
                android:id="@+id/waveform_recording"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="8dp"/>

            <TextView
                android:id="@+id/tv_swipe_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← отмена"
                android:textColor="@color/text_hint"
                android:textSize="11sp"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:id="@+id/tv_swipe_lock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↑ фикс"
                android:textColor="@color/accent_cyan"
                android:textSize="11sp"/>

        </LinearLayout>

        <!-- Swipe progress bar (shows how close to lock/cancel) -->
        <View
            android:id="@+id/swipe_progress"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="4dp"
            android:background="@color/accent_cyan"
            android:visibility="invisible"/>

        <!-- LOCKED MODE: controls row -->
        <LinearLayout
            android:id="@+id/layout_locked_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <!-- Delete -->
            <ImageButton
                android:id="@+id/btn_record_delete"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_delete"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="@color/accent_rose"
                android:padding="10dp"
                android:contentDescription="Удалить"/>

            <!-- Timer (locked) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="6dp">

                <TextView
                    android:id="@+id/tv_record_dot_locked"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔴"
                    android:textSize="11sp"
                    android:layout_marginEnd="4dp"/>

                <TextView
                    android:id="@+id/tv_recording_time_locked"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="@color/accent_rose"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"/>

                <com.fitnesstrainer.app.ui.chat.WaveformView
                    android:id="@+id/waveform_recording_locked"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"/>

            </LinearLayout>

            <!-- Pause / Resume -->
            <ImageButton
                android:id="@+id/btn_record_pause"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_pause"
                android:background="@drawable/bg_record_btn_active"
                android:padding="12dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="Пауза"/>

            <!-- Send -->
            <ImageButton
                android:id="@+id/btn_record_send"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_send"
                android:background="@drawable/bg_send_button"
                android:padding="12dp"
                android:contentDescription="Отправить"/>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
