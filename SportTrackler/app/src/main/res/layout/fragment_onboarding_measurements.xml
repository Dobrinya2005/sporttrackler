<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/bgPrimary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/gradient_header"
            android:paddingTop="52dp"
            android:paddingBottom="24dp"
            android:paddingHorizontal="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ШАГ 3 ИЗ 4"
                android:textColor="@color/accent_indigo"
                android:textSize="10sp"
                android:letterSpacing="0.16"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Начальные замеры"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Зафиксируем стартовую точку для отслеживания прогресса"
                android:textColor="@color/text_hint"
                android:textSize="13sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp">

            <!-- Row: Грудь / Талия -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_chest"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    style="@style/InputField"
                    app:boxStrokeColor="@color/accent_indigo"
                    app:hintTextColor="@color/accent_indigo"
                    android:hint="Грудь (см)"
                    app:suffixText="см">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_chest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="@color/text_primary"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_waist"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    style="@style/InputField"
                    app:boxStrokeColor="@color/accent_indigo"
                    app:hintTextColor="@color/accent_indigo"
                    android:hint="Талия (см)"
                    app:suffixText="см">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_waist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="@color/text_primary"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Row: Бёдра / Бицепс -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_hips"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    style="@style/InputField"
                    app:boxStrokeColor="@color/accent_indigo"
                    app:hintTextColor="@color/accent_indigo"
                    android:hint="Бёдра (см)"
                    app:suffixText="см">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_hips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="@color/text_primary"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_bicep"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    style="@style/InputField"
                    app:boxStrokeColor="@color/accent_indigo"
                    app:hintTextColor="@color/accent_indigo"
                    android:hint="Бицепс (см)"
                    app:suffixText="см">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_bicep"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="@color/text_primary"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- % жира -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_body_fat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                style="@style/InputField"
                app:boxStrokeColor="@color/accent_indigo"
                app:hintTextColor="@color/accent_indigo"
                android:hint="% жира (необязательно)"
                app:suffixText="%">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_body_fat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="@color/text_primary"/>
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tv_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/accent_rose"
                android:textSize="13sp"
                android:visibility="gone"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:text="Сохранить замеры"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                app:cornerRadius="16dp"
                app:backgroundTint="@color/accent_indigo"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_skip"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="Пропустить, добавлю позже"
                android:textSize="14sp"
                android:textColor="@color/text_hint"
                app:cornerRadius="16dp"
                style="@style/Widget.MaterialComponents.Button.TextButton"/>

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:visibility="gone"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>

