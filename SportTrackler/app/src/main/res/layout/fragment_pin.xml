<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/bg_primary"
    android:padding="32dp">

    <TextView
        android:id="@+id/tv_pin_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Создайте PIN-код"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tv_pin_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Введите 4-значный PIN для входа в приложение"
        android:textColor="@color/text_hint"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="40dp"/>

    <!-- 4 dots -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="48dp">

        <View android:id="@+id/dot1"
            android:layout_width="18dp" android:layout_height="18dp"
            android:background="@drawable/pin_dot_empty"
            android:layout_margin="10dp"/>
        <View android:id="@+id/dot2"
            android:layout_width="18dp" android:layout_height="18dp"
            android:background="@drawable/pin_dot_empty"
            android:layout_margin="10dp"/>
        <View android:id="@+id/dot3"
            android:layout_width="18dp" android:layout_height="18dp"
            android:background="@drawable/pin_dot_empty"
            android:layout_margin="10dp"/>
        <View android:id="@+id/dot4"
            android:layout_width="18dp" android:layout_height="18dp"
            android:background="@drawable/pin_dot_empty"
            android:layout_margin="10dp"/>
    </LinearLayout>

    <!-- Numpad -->
    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4">

        <!-- Row 1: 1 2 3 -->
        <Button style="@style/PinKey" android:id="@+id/btn1" android:text="1"/>
        <Button style="@style/PinKey" android:id="@+id/btn2" android:text="2"/>
        <Button style="@style/PinKey" android:id="@+id/btn3" android:text="3"/>
        <!-- Row 2: 4 5 6 -->
        <Button style="@style/PinKey" android:id="@+id/btn4" android:text="4"/>
        <Button style="@style/PinKey" android:id="@+id/btn5" android:text="5"/>
        <Button style="@style/PinKey" android:id="@+id/btn6" android:text="6"/>
        <!-- Row 3: 7 8 9 -->
        <Button style="@style/PinKey" android:id="@+id/btn7" android:text="7"/>
        <Button style="@style/PinKey" android:id="@+id/btn8" android:text="8"/>
        <Button style="@style/PinKey" android:id="@+id/btn9" android:text="9"/>
        <!-- Row 4: biometric 0 delete -->
        <Button
            android:id="@+id/btn_biometric"
            style="@style/PinKey"
            android:text="🔐"
            android:textSize="20sp"
            android:visibility="gone"/>
        <Button style="@style/PinKey" android:id="@+id/btn0" android:text="0"/>
        <Button
            android:id="@+id/btn_delete"
            style="@style/PinKey"
            android:text="⌫"
            android:textSize="18sp"/>
    </GridLayout>

    <TextView
        android:id="@+id/tv_pin_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="#FF5252"
        android:textSize="14sp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tv_skip_pin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Задать PIN позже"
        android:textColor="@color/text_hint"
        android:textSize="13sp"
        android:paddingVertical="8dp"
        android:paddingHorizontal="16dp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tv_forgot_pin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Выйти из аккаунта"
        android:textColor="@color/text_hint"
        android:textSize="13sp"
        android:paddingVertical="8dp"
        android:paddingHorizontal="16dp"
        android:visibility="gone"/>

</LinearLayout>
