<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="4dp"
    android:paddingTop="20dp"
    android:paddingBottom="8dp"
    android:gravity="center_vertical">

    <!-- Meal emoji badge -->
    <FrameLayout
        android:id="@+id/meal_icon_container"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_food_emoji_circle"
        android:layout_marginEnd="12dp">

        <TextView
            android:id="@+id/tv_meal_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="🍽️"
            android:textSize="18sp"/>

    </FrameLayout>

    <!-- Meal name + calories -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_meal_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.01"/>

        <TextView
            android:id="@+id/tv_meal_calories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_hint"
            android:textSize="12sp"/>

    </LinearLayout>

    <!-- Add button: modern pill with gradient border -->
    <LinearLayout
        android:id="@+id/btn_add_food"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_btn_add_food"
        android:paddingHorizontal="14dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+"
            android:textColor="@color/accent_cyan"
            android:textSize="18sp"
            android:fontFamily="sans-serif-light"
            android:includeFontPadding="false"
            android:paddingBottom="1dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" Добавить"
            android:textColor="@color/accent_cyan"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.01"
            android:includeFontPadding="false"/>

    </LinearLayout>

</LinearLayout>
