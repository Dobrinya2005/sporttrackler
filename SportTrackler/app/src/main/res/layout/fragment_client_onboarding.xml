<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/bgPrimary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/gradient_header"
            android:paddingTop="52dp"
            android:paddingBottom="24dp"
            android:paddingHorizontal="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ШАГ 2 ИЗ 4"
                android:textColor="@color/accent_indigo"
                android:textSize="10sp"
                android:letterSpacing="0.16"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Расскажите о себе"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Эти данные помогут тренеру составить план"
                android:textColor="@color/text_hint"
                android:textSize="13sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp">

            <!-- Цель -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ЦЕЛЬ ТРЕНИРОВОК"
                android:textColor="@color/text_hint"
                android:textSize="11sp"
                android:letterSpacing="0.14"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="12dp"/>

            <RadioGroup
                android:id="@+id/rg_goal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rb_goal_lose"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="🔥  Похудение"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_card_surface"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rb_goal_gain"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="💪  Набор мышечной массы"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_card_surface"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rb_goal_maintain"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="⚖️  Поддержание формы"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_card_surface"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rb_goal_endurance"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="🏃  Повышение выносливости"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_card_surface"/>
            </RadioGroup>

            <!-- Уровень активности -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="УРОВЕНЬ АКТИВНОСТИ"
                android:textColor="@color/text_hint"
                android:textSize="11sp"
                android:letterSpacing="0.14"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"/>

            <RadioGroup
                android:id="@+id/rg_activity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rb_activity_beginner"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="🌱  Начинающий (менее 1 года)"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_card_surface"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rb_activity_intermediate"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="⚡  Средний (1–3 года)"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_card_surface"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rb_activity_advanced"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="🏆  Продвинутый (3+ года)"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_card_surface"/>
            </RadioGroup>

            <!-- Вес и рост -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ТЕКУЩИЕ ПАРАМЕТРЫ"
                android:textColor="@color/text_hint"
                android:textSize="11sp"
                android:letterSpacing="0.14"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_weight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    style="@style/InputField"
                    app:boxStrokeColor="@color/accent_indigo"
                    app:hintTextColor="@color/accent_indigo"
                    android:hint="Вес (кг)"
                    app:suffixText="кг">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_weight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="@color/text_primary"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_height"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    style="@style/InputField"
                    app:boxStrokeColor="@color/accent_indigo"
                    app:hintTextColor="@color/accent_indigo"
                    android:hint="Рост (см)"
                    app:suffixText="см">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_height"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="@color/text_primary"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_goal_weight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                style="@style/InputField"
                app:boxStrokeColor="@color/accent_indigo"
                app:hintTextColor="@color/accent_indigo"
                android:hint="Целевой вес (кг, необязательно)"
                app:suffixText="кг">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_goal_weight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="@color/text_primary"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Buttons -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_next"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:text="Далее →"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                app:cornerRadius="16dp"
                app:backgroundTint="@color/accent_indigo"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_skip"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="Заполнить позже"
                android:textSize="14sp"
                android:textColor="@color/text_hint"
                app:cornerRadius="16dp"
                style="@style/Widget.MaterialComponents.Button.TextButton"/>

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:visibility="gone"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
