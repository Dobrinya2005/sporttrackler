<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- Radial glow behind logo -->
    <View
        android:id="@+id/glow"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:background="@drawable/bg_glow"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="@id/logo"
        app:layout_constraintEnd_toEndOf="@id/logo"
        app:layout_constraintStart_toStartOf="@id/logo"
        app:layout_constraintTop_toTopOf="@id/logo"/>

    <!-- Floating icon: Dumbbell (left) -->
    <ImageView
        android:id="@+id/icon_dumbbell"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_dumbbell"
        android:alpha="0"
        android:scaleX="0.6"
        android:scaleY="0.6"
        app:layout_constraintTop_toTopOf="@id/logo"
        app:layout_constraintBottom_toBottomOf="@id/logo"
        app:layout_constraintStart_toStartOf="@id/logo"
        app:layout_constraintEnd_toEndOf="@id/logo"/>

    <!-- Floating icon: Barbell (right) -->
    <ImageView
        android:id="@+id/icon_barbell"
        android:layout_width="52dp"
        android:layout_height="26dp"
        android:src="@drawable/ic_barbell"
        android:alpha="0"
        android:scaleX="0.6"
        android:scaleY="0.6"
        app:layout_constraintTop_toTopOf="@id/logo"
        app:layout_constraintBottom_toBottomOf="@id/logo"
        app:layout_constraintStart_toStartOf="@id/logo"
        app:layout_constraintEnd_toEndOf="@id/logo"/>

    <!-- Floating icon: Nutrition / Apple (upper left) -->
    <ImageView
        android:id="@+id/icon_nutrition"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/ic_nutrition"
        android:alpha="0"
        android:scaleX="0.6"
        android:scaleY="0.6"
        app:layout_constraintTop_toTopOf="@id/logo"
        app:layout_constraintBottom_toBottomOf="@id/logo"
        app:layout_constraintStart_toStartOf="@id/logo"
        app:layout_constraintEnd_toEndOf="@id/logo"/>

    <!-- Floating icon: Kettlebell (upper right) -->
    <ImageView
        android:id="@+id/icon_kettlebell"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/ic_kettlebell"
        android:alpha="0"
        android:scaleX="0.6"
        android:scaleY="0.6"
        app:layout_constraintTop_toTopOf="@id/logo"
        app:layout_constraintBottom_toBottomOf="@id/logo"
        app:layout_constraintStart_toStartOf="@id/logo"
        app:layout_constraintEnd_toEndOf="@id/logo"/>

    <!-- App logo -->
    <ImageView
        android:id="@+id/logo"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/ic_app_logo"
        android:scaleType="fitCenter"
        android:scaleX="0.3"
        android:scaleY="0.3"
        android:alpha="0"
        app:layout_constraintBottom_toTopOf="@id/app_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.4"/>

    <!-- App name -->
    <TextView
        android:id="@+id/app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="SportTrackler"
        android:textColor="@color/text_primary"
        android:textSize="34sp"
        android:letterSpacing="0.08"
        android:fontFamily="sans-serif-medium"
        android:alpha="0"
        android:translationY="30dp"
        app:layout_constraintTop_toBottomOf="@id/logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tagline"/>

    <!-- Tagline -->
    <TextView
        android:id="@+id/tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Тренируйся. Питайся. Достигай."
        android:textColor="@color/text_hint"
        android:textSize="13sp"
        android:letterSpacing="0.05"
        android:fontFamily="sans-serif"
        android:alpha="0"
        android:translationY="20dp"
        app:layout_constraintTop_toBottomOf="@id/app_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <!-- Loader at bottom -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="52dp"
        android:alpha="0"
        app:indicatorColor="@color/accent_cyan"
        app:trackColor="@color/bg_elevated"
        app:trackCornerRadius="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/Widget.Material3.LinearProgressIndicator"/>

    <!-- Version label -->
    <TextView
        android:id="@+id/tvVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="v1.0"
        android:textColor="@color/bg_elevated"
        android:textSize="11sp"
        android:fontFamily="sans-serif"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
