<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="4dp"
    android:paddingHorizontal="8dp"
    android:gravity="start">

    <!-- Video note: circle + seekbar below -->
    <LinearLayout
        android:id="@+id/layout_video_note"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/layout_video_note_circle"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:background="@drawable/bg_video_note_bubble"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/iv_video_note_thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_video_note"/>

            <TextureView
                android:id="@+id/texture_video_note"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"/>

            <FrameLayout
                android:id="@+id/video_note_play_overlay"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:background="#88000000">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="▶"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"/>
            </FrameLayout>

            <TextView
                android:id="@+id/tv_video_note_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="8dp"
                android:textColor="#CCFFFFFF"
                android:textSize="11sp"
                android:background="#66000000"
                android:paddingHorizontal="5dp"
                android:paddingVertical="2dp"/>

        </FrameLayout>

        <!-- Seekbar + duration, visible during playback -->
        <LinearLayout
            android:id="@+id/layout_video_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="4dp"
            android:visibility="gone">

            <SeekBar
                android:id="@+id/seekbar_video_note"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:progressTint="@color/accent_indigo"
                android:thumbTint="@color/accent_indigo"
                android:max="1000"/>

            <TextView
                android:id="@+id/tv_video_note_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="0:00"
                android:textColor="@color/text_hint"
                android:textSize="11sp"/>

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:maxWidth="260dp"
        android:background="@drawable/bg_message_received"
        android:padding="10dp">

        <TextView
            android:id="@+id/tv_sender_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:textColor="@color/accent_cyan"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"/>

        <!-- Image attachment -->
        <FrameLayout
            android:id="@+id/layout_image"
            android:layout_width="200dp"
            android:layout_height="160dp"
            android:layout_marginBottom="6dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_attachment"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="#1A1A2E"
                android:clipToOutline="true"/>

            <FrameLayout
                android:id="@+id/video_play_overlay"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="#88000000"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="▶"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"/>
            </FrameLayout>

        </FrameLayout>

        <!-- Audio / Voice message -->
        <LinearLayout
            android:id="@+id/layout_audio"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1A2A3A"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:layout_marginBottom="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/btn_play_audio"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="▶"
                android:textColor="@color/accent_cyan"
                android:textSize="16sp"
                android:background="#22FFFFFF"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <com.fitnesstrainer.app.ui.chat.WaveformView
                    android:id="@+id/waveform_audio"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_audio_duration"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0:00"
                        android:textColor="@color/text_hint"
                        android:textSize="10sp"/>

                    <TextView
                        android:id="@+id/btn_audio_speed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="×1"
                        android:textColor="@color/text_hint"
                        android:textSize="10sp"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="2dp"
                        android:background="#22FFFFFF"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- File attachment -->
        <LinearLayout
            android:id="@+id/layout_file"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1A2A3A"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:layout_marginBottom="6dp"
            android:visibility="gone">

            <TextView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="📎"
                android:textSize="18sp"/>

            <TextView
                android:id="@+id/tv_file_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="middle"/>
        </LinearLayout>

        <!-- Text -->
        <TextView
            android:id="@+id/tv_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:visibility="gone"/>

        <!-- Time -->
        <TextView
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_gravity="end"
            android:textColor="@color/text_hint"
            android:textSize="11sp"/>
    </LinearLayout>  <!-- end layout_bubble -->

</LinearLayout>
